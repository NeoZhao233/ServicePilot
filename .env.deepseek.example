# DeepSeek supports the Responses API used for intent routing and LLM-as-Judge.
# Never commit a real key. Load this file into your shell after replacing the value.
SERVICEPILOT_API_KEY=replace-with-your-deepseek-key
SERVICEPILOT_BASE_URL=https://api.deepseek.com
SERVICEPILOT_INTENT_MODEL=deepseek-flash

# DeepSeek does not document an Embeddings endpoint. Use local BGE semantic vectors.
SERVICEPILOT_EMBEDDING_MODE=local
SERVICEPILOT_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
SERVICEPILOT_TIMEOUT_SECONDS=60
