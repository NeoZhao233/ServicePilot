# Do not commit a real key. Load these variables in your shell before online runs.
SERVICEPILOT_API_KEY=replace-me
SERVICEPILOT_CONTEXT_COMPACTION=0
# 开启压缩需使用在线模式；摘要模型默认 deepseek-chat。
# SERVICEPILOT_CONTEXT_MODEL=deepseek-chat
CONTEXT_MAX_MESSAGES=30
CONTEXT_MAX_TOKENS=4000
CONTEXT_KEEP_RECENT_MESSAGES=8
SERVICEPILOT_BASE_URL=https://api.openai.com/v1
SERVICEPILOT_INTENT_MODEL=replace-with-a-structured-output-model
SERVICEPILOT_EMBEDDING_MODEL=replace-with-an-embedding-model
SERVICEPILOT_EMBEDDING_MODE=api
SERVICEPILOT_TIMEOUT_SECONDS=20

# Optional API/runtime settings
SERVICEPILOT_ONLINE=false
SERVICEPILOT_SESSION_DB=.servicepilot/sessions.sqlite3
# Optional user PDF storage and image-capable model for PDF questions.
# SERVICEPILOT_PDF_DIR=.servicepilot/pdfs
# SERVICEPILOT_VISION_MODEL=replace-with-an-image-capable-model
# SERVICEPILOT_PDF_ANSWER_MODEL=replace-with-a-text-answer-model

# Dynamic task execution is opt-in. Both paths retain transactional safety.
SERVICEPILOT_DYNAMIC_PLANNING=false
SERVICEPILOT_COMMERCE_DB=.servicepilot/sessions.sqlite3
# Optional: candidate plans through /chat/completions JSON mode.
# With a native DeepSeek endpoint, keep existing Responses-based online router disabled.
# SERVICEPILOT_PLANNER_MODEL=deepseek-chat
# SERVICEPILOT_FAILURE_MEMORY_ROUTING=1  # optional verified intent lessons; default off
# SERVICEPILOT_EMBEDDING_MODE=hashing
# Optional HTTP identity map; unset means local demo mode with caller-supplied user_id.
# SERVICEPILOT_AUTH_TOKENS={"replace-with-secret-token":"USER-001"}
# MCP CLI binds one trusted user to its connection.
SERVICEPILOT_MCP_USER=USER-001

# Agent Trace: same SQLite as commerce by default; optional separate file.
SERVICEPILOT_TRACE_ENABLED=true
SERVICEPILOT_TRACE_SAMPLE_RATE=1
SERVICEPILOT_TRACE_DETAILS=false
SERVICEPILOT_TRACE_RETENTION_DAYS=14
# SERVICEPILOT_TRACE_DB=.servicepilot/traces.sqlite3
# Optional stable secret shared by workers; otherwise a key is persisted in obs_meta.
# SERVICEPILOT_TRACE_HMAC_KEY=replace-with-a-strong-secret

# Corrective RAG remains opt-in; existing retrieval stays the default.
SERVICEPILOT_RAG_MODE=original
# Modes: original (B0), evidence_score (B1), evidence_check (B2), corrective (B3)
SERVICEPILOT_EVALUATOR_PROVIDER=deepseek
SERVICEPILOT_EVALUATOR_FALLBACK=false
SERVICEPILOT_EVALUATOR_TIMEOUT=30
SERVICEPILOT_EVALUATOR_CONCURRENCY=2
SERVICEPILOT_EVALUATOR_RETRIES=0
SERVICEPILOT_EVALUATOR_MAX_OUTPUT_TOKENS=8192
# Below: previous Jev-only research modes, not required by DeepSeek.
# TYPESAFE_API_KEY=replace-with-your-own-key
SERVICEPILOT_JEV_MODEL=jev-latest
SERVICEPILOT_JEV_SCORING_MODE=listwise
SERVICEPILOT_JEV_TIMEOUT=8
SERVICEPILOT_RAG_MAX_CORRECTIONS=2
# Legacy Jev filtering/correction require independent calibration; DeepSeek modes do not.
# SERVICEPILOT_JEV_CALIBRATION=path/to/calibration.json
# SERVICEPILOT_POLICY_SOURCES=your-reviewed-policy-source
